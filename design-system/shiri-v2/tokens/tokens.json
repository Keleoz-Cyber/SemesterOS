{
  "$schema": "shiri-v2 design tokens · 「晴日」",
  "version": "2.0.0",
  "source": "Derived from apps/mobile/assets/brand/app_icon.svg (2026-10-08 icon). Units: Flutter logical px (dp/sp). Colors: #RRGGBB or rgba().",
  "color": {
    "light": {
      "bg": "#F3F7FC",
      "bgTint": "#EAF3FD",
      "surface": "#FFFFFF",
      "surfaceSunken": "#EEF3F9",
      "surfaceGlass": "rgba(255,255,255,0.74)",
      "line": "#E4ECF5",
      "lineStrong": "#D2DDEA",
      "ink900": "#142238",
      "ink700": "#33435C",
      "ink500": "#5B6B82",
      "ink400": "#8291A7",
      "inkInverse": "#FFFFFF",
      "primary": "#2E6FE0",
      "primaryPressed": "#2459BD",
      "primarySoft": "#EAF2FF",
      "primarySoftStrong": "#D7E7FF",
      "onPrimary": "#FFFFFF",
      "success": "#0F7F63",
      "successSoft": "#E3F6EE",
      "successAccent": "#3FBF8F",
      "warning": "#96620A",
      "warningSoft": "#FFF4D6",
      "warningAccent": "#F2B33D",
      "danger": "#C2412D",
      "dangerSoft": "#FDECE8",
      "dangerAccent": "#F0705A",
      "scrim": "rgba(20,34,56,0.32)",
      "focusRing": "rgba(46,111,224,0.40)"
    },
    "dark": {
      "_note": "Phase 2. Same roles as light.",
      "bg": "#0B1220",
      "bgTint": "#0F1A2E",
      "surface": "#121C2F",
      "surfaceSunken": "#0E1727",
      "surfaceGlass": "rgba(18,28,47,0.72)",
      "line": "#22304A",
      "lineStrong": "#2C3C5A",
      "ink900": "#EEF3FA",
      "ink700": "#C9D4E4",
      "ink500": "#9AA9BF",
      "ink400": "#74839A",
      "inkInverse": "#0B1220",
      "primary": "#6FA8FF",
      "primaryPressed": "#8AB8FF",
      "primarySoft": "#17284A",
      "primarySoftStrong": "#1F3560",
      "onPrimary": "#0B1220",
      "success": "#5ED1A6",
      "successSoft": "#12322A",
      "successAccent": "#3FBF8F",
      "warning": "#F2C96B",
      "warningSoft": "#33280F",
      "warningAccent": "#F2B33D",
      "danger": "#FF8E7A",
      "dangerSoft": "#3A1D19",
      "dangerAccent": "#F0705A",
      "scrim": "rgba(0,0,0,0.48)",
      "focusRing": "rgba(111,168,255,0.45)"
    },
    "brand": {
      "sky": "#4CA4FF",
      "cyan": "#63CFE9",
      "mint": "#8DE0B2",
      "sun300": "#FFEBA6",
      "sun500": "#F6C86B",
      "sunInk": "#96620A",
      "tileTop": "#F8FCFF",
      "tileMid": "#FFFEFC",
      "tileBottom": "#F0F8FF"
    }
  },
  "gradient": {
    "brand": { "angle": 135, "stops": [["#4CA4FF", 0], ["#63CFE9", 0.52], ["#8DE0B2", 1]], "use": "decorative only: progress, active indicators, icon duotone, hero accents, illustrations. Never behind small text." },
    "brandSoft": { "angle": 135, "stops": [["#EAF4FF", 0], ["#E6F8FB", 0.52], ["#EAF8F0", 1]], "use": "tinted card / section backgrounds" },
    "sun": { "angle": 160, "stops": [["#FFEBA6", 0], ["#F6C86B", 1]], "use": "today / now highlights, sun & moon, celebration accents; small doses" },
    "primaryButton": { "angle": 180, "stops": [["#3A7FEA", 0], ["#2A64D2", 1]], "use": "optional filled-button sheen; label contrast >= 4.5:1 at center" },
    "sky": {
      "_rule": "Today hero background follows the device's Beijing time. Text on dawn/day/dusk uses ink900; on night uses inkInverse.",
      "dawn": { "from": "05:00", "to": "08:00", "angle": 180, "stops": [["#FFE7C2", 0], ["#FFF3E2", 0.45], ["#EEF5FF", 1]] },
      "day": { "from": "08:00", "to": "16:30", "angle": 180, "stops": [["#D6EAFF", 0], ["#EAF4FF", 0.5], ["#F6FAFF", 1]] },
      "dusk": { "from": "16:30", "to": "19:00", "angle": 180, "stops": [["#FFDCCB", 0], ["#F3E6FF", 0.5], ["#EAF0FF", 1]] },
      "night": { "from": "19:00", "to": "05:00", "angle": 180, "stops": [["#1B2747", 0], ["#263A66", 0.55], ["#34507F", 1]] }
    },
    "wave": {
      "back": { "stops": [["#D5EFEA", 0], ["#D8EAFB", 1]], "opacity": 0.82 },
      "front": { "stops": [["#CFEDE9", 0], ["#CDE2F8", 1]], "opacity": 0.88 }
    }
  },
  "coursePalettes": [
    { "id": "sky", "name": "晴蓝", "bg": "#E8F2FF", "accent": "#4A90F0", "text": "#1D5BB5" },
    { "id": "mint", "name": "薄荷", "bg": "#E4F6EF", "accent": "#3DBE8B", "text": "#0F7656" },
    { "id": "aqua", "name": "青湖", "bg": "#E3F6FA", "accent": "#33B5CF", "text": "#0E6F85" },
    { "id": "lilac", "name": "藤紫", "bg": "#EFECFF", "accent": "#8C7BF0", "text": "#5443BE" },
    { "id": "apricot", "name": "杏橙", "bg": "#FFF0E6", "accent": "#F39A62", "text": "#A9501F" },
    { "id": "blossom", "name": "樱粉", "bg": "#FDECF2", "accent": "#E7779D", "text": "#A83A61" },
    { "id": "wheat", "name": "麦黄", "bg": "#FFF6DD", "accent": "#E5B23C", "text": "#8A6100" },
    { "id": "mist", "name": "雾灰", "bg": "#EDF1F6", "accent": "#8193AB", "text": "#44566E" }
  ],
  "kindStyles": {
    "_rule": "Kind is never shown by color alone: each kind also differs in fill/border style, icon or badge (MASTER accessibility rule).",
    "course": { "fill": "palette.bg", "accentBar": "palette.accent 3dp left", "text": "palette.text", "border": "none", "badge": null },
    "event": { "fill": "#FFFFFF", "accentBar": "#3FBF8F 3dp left", "text": "#0F6B52", "border": "1.5dp #BFE9D6", "icon": "event" },
    "plan": { "fill": "#EAF2FF", "accentBar": "gradient.brand 3dp left", "text": "#1D5BB5", "border": "1.5dp dashed #8DBBF5 (dash 4, gap 3)", "badge": "计划" },
    "exam": { "fill": "#FDECE8", "accentBar": "#F0705A 3dp left", "text": "#B03A26", "border": "none", "badge": "考试" },
    "deadline": { "style": "time marker, not a block: 2dp line #F2B33D across the day + flag icon + label", "text": "#8A6100" }
  },
  "typography": {
    "fontFamily": "system (Android: Roboto + Noto Sans CJK SC)",
    "numeric": "same family with FontFeature.tabularFigures()",
    "styles": {
      "display": { "size": 34, "height": 40, "weight": 700, "letterSpacing": -0.6 },
      "headline": { "size": 26, "height": 32, "weight": 700, "letterSpacing": -0.3 },
      "title": { "size": 20, "height": 26, "weight": 600, "letterSpacing": 0 },
      "titleSmall": { "size": 17, "height": 24, "weight": 600, "letterSpacing": 0 },
      "body": { "size": 16, "height": 24, "weight": 400, "letterSpacing": 0 },
      "bodyStrong": { "size": 16, "height": 24, "weight": 600, "letterSpacing": 0 },
      "bodySmall": { "size": 14, "height": 20, "weight": 400, "letterSpacing": 0 },
      "label": { "size": 13, "height": 18, "weight": 600, "letterSpacing": 0.2 },
      "caption": { "size": 12, "height": 16, "weight": 500, "letterSpacing": 0.2 },
      "numXL": { "size": 44, "height": 48, "weight": 700, "letterSpacing": -1.2, "tabular": true },
      "numL": { "size": 28, "height": 32, "weight": 700, "letterSpacing": -0.6, "tabular": true },
      "numM": { "size": 17, "height": 22, "weight": 600, "letterSpacing": 0, "tabular": true },
      "numS": { "size": 13, "height": 16, "weight": 600, "letterSpacing": 0, "tabular": true }
    }
  },
  "space": { "scale": [0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 56, 72], "page": 20, "pageCompact": 16, "card": 16, "cardLoose": 20, "sectionGap": 28, "itemGap": 12 },
  "radius": { "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 28, "pill": 999, "iconTileRatio": 0.22 },
  "shadow": {
    "card": [{ "x": 0, "y": 1, "blur": 2, "color": "rgba(20,34,56,0.04)" }, { "x": 0, "y": 6, "blur": 16, "color": "rgba(20,34,56,0.06)" }],
    "raised": [{ "x": 0, "y": 2, "blur": 6, "color": "rgba(20,34,56,0.05)" }, { "x": 0, "y": 14, "blur": 32, "color": "rgba(46,111,224,0.12)" }],
    "floating": [{ "x": 0, "y": 2, "blur": 8, "color": "rgba(20,34,56,0.06)" }, { "x": 0, "y": 10, "blur": 36, "color": "rgba(20,34,56,0.14)" }],
    "glowBrand": [{ "x": 0, "y": 8, "blur": 24, "color": "rgba(76,164,255,0.32)" }],
    "glowSun": [{ "x": 0, "y": 6, "blur": 20, "color": "rgba(246,200,107,0.45)" }],
    "_rule": "Shadows on cards and floating layers only, never on every list row. Blur <= 36."
  },
  "material": {
    "glass": { "fill": "color.surfaceGlass", "blur": 20, "border": "1dp rgba(255,255,255,0.65)", "fallback": "rgba(255,255,255,0.94) without blur (low-end / reduced transparency)" },
    "sheen": "hero cards: white 0.55 -> 0 linear gradient over the top 40%, like the icon's highlight arc",
    "wave": "two static wave layers (gradient.wave) on hero bottoms, onboarding and empty states; no perpetual drift"
  },
  "motion": {
    "duration": { "tap": 90, "quick": 160, "standard": 260, "emphasized": 380, "slow": 520, "stagger": 36, "maxStaggerItems": 8, "shimmerLoop": 1200 },
    "curve": {
      "standard": [0.2, 0.0, 0.0, 1.0],
      "decelerate": [0.05, 0.7, 0.1, 1.0],
      "accelerate": [0.3, 0.0, 0.8, 0.15],
      "reveal": [0.16, 1.0, 0.3, 1.0],
      "_rule": "enter = decelerate, exit = accelerate, move/resize = standard, text & card reveals = reveal. Linear only for shimmer and progress."
    },
    "spring": {
      "snappy": { "mass": 1, "stiffness": 520, "damping": 38, "use": "selection indicators, tab pill, segmented control, chips" },
      "gentle": { "mass": 1, "stiffness": 260, "damping": 26, "use": "sheets, cards settling after drag, dock collapse" },
      "pop": { "mass": 1, "stiffness": 420, "damping": 20, "use": "completion check pop only" }
    },
    "haptic": { "selection": "week scrub, segmented, picker detent", "light": "complete, toggle, card open", "medium": "long-press quick add, drag start" },
    "reducedMotion": "MediaQuery.disableAnimations: durations 0 (opacity <= 120ms allowed), no springs/parallax/stagger, no sun-rise intro."
  },
  "layout": {
    "dock": { "height": 64, "radius": 28, "sideInset": 12, "bottomInset": 12, "indicator": { "w": 56, "h": 32, "radius": 16 } },
    "assistantPill": { "height": 52, "radius": 26, "collapsed": 52, "gapAboveDock": 10 },
    "todayHero": { "expanded": 236, "collapsed": 92, "overlapNextCard": 28 },
    "weekGrid": { "timeAxis": 44, "periodRow": 56, "minBlock": 44, "dayHeader": 56 },
    "touchTarget": 48
  }
}
